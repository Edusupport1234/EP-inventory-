rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Support guest-friendly real-time state management across all app collections
    
    match /inventory/{itemId} {
      allow read, write: if true;
    }

    match /racks/{rackId} {
      allow read, write: if true;
    }

    match /sketchItems/{itemId} {
      allow read, write: if true;
    }

    match /adjustments/{adjId} {
      allow read, write: if true;
    }

    match /reservations/{resId} {
      allow read, write: if true;
    }

    match /statuses/{statusId} {
      allow read, write: if true;
    }

    match /system/{docId} {
      allow read, write: if true;
    }

    match /userAccounts/{userId} {
      allow read, write: if true;
    }
  }
}
